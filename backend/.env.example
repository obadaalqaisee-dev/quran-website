# Copy to .env for local overrides. No secrets are required by this application.
# NEVER commit a real .env file (it is git-ignored).

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite (default) or PostgreSQL, e.g. postgresql+psycopg://user:password@host:5432/quran
DATABASE_URL=sqlite:///./quran.sqlite3

# Comma-separated browser origins allowed to call the API.
# Production frontend: the GitHub Pages site.
CORS_ORIGINS=https://obadaalqaisee-dev.github.io

# Optional switches (default: on in development, off in production)
# ENABLE_DOCS=false
# SERVE_STATIC=false

# Rate limiting: requests per window per client IP
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=240
RATE_LIMIT_UPSTREAM=30

UPSTREAM_TIMEOUT_SECONDS=8
